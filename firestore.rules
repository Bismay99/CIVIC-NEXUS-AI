rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for authorization
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (request.auth.token.role == 'admin' ||
         (request.auth.token.email != null && request.auth.token.email.matches('.*@admin\\.civicnexus\\.gov\\.in')));
    }

    // Citizen Profiles
    match /users/{userId} {
      allow read: if isAuthenticated();
      // Citizen can only write their own profile and cannot elevate role
      allow create, update: if isOwner(userId) &&
        (!request.resource.data.keys().hasAny(['role']) || request.resource.data.role == 'citizen' || isAdmin());
      allow delete: if isAdmin();
    }

    // User-scoped notifications
    match /users/{userId}/notifications/{notificationId} {
      allow read, update: if isOwner(userId) || isAdmin();
      allow create, delete: if isAdmin();
    }

    // Global Complaints Collection
    match /complaints/{complaintId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin() || (
        isAuthenticated() &&
        (
          // Citizen allowed to reopen their own complaint or add feedback, but cannot change ownership or resolve
          resource.data.userId == request.auth.uid &&
          request.resource.data.userId == resource.data.userId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'lastNote', 'updatedAt', 'timelineJson']) &&
          request.resource.data.status in ['REOPENED', resource.data.status]
        )
      );
      allow delete: if isAdmin();
    }

    // User-scoped complaints
    match /users/{userId}/complaints/{complaintId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // City incidents & community verifications
    match /incidents/{incidentId} {
      allow read: if isAuthenticated();
      // Allow community confirmation / upvoting
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['verifiedCount']) &&
          request.resource.data.verifiedCount == resource.data.verifiedCount + 1
        )
      );
      allow create, delete: if isAdmin();
    }

    // Public municipal facilities
    match /facilities/{facilityId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Default catch-all denies unauthorized access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
